<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>For Amira, with all my love</title>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{--deep:#5c0a1c;--red:#c1122f;--rose:#ff4d6d;--blush:#ffd6de;--cream:#fff4f1;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{background:radial-gradient(ellipse at 50% 0%,var(--red),var(--deep) 75%) fixed;color:var(--cream);font-family:'Cormorant Garamond',Georgia,serif;font-size:1.3rem;line-height:1.7;overflow-x:hidden}
#hearts{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.h{position:absolute;bottom:-60px;opacity:0;animation:rise linear infinite;filter:drop-shadow(0 0 6px rgba(255,77,109,.6))}
@keyframes rise{0%{transform:translateY(0) rotate(-12deg);opacity:0}10%{opacity:.85}90%{opacity:.6}100%{transform:translateY(-115vh) rotate(14deg);opacity:0}}
main{position:relative;z-index:1}
section{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:4rem 1.5rem}
.hero{min-height:100vh}
.script{font-family:'Great Vibes','Brush Script MT',cursive;font-weight:400}
h1{font-size:clamp(3.2rem,13vw,7.5rem);line-height:1.05;text-shadow:0 0 30px rgba(255,77,109,.7)}
h1 span{display:block;font-size:clamp(4rem,17vw,9.5rem);color:var(--blush)}
.beat{display:inline-block;animation:beat 1.4s ease-in-out infinite;color:var(--rose);margin-top:1rem;font-size:3rem}
@keyframes beat{0%,100%{transform:scale(1)}15%{transform:scale(1.25)}30%{transform:scale(1)}45%{transform:scale(1.18)}}
.sub{font-style:italic;max-width:32ch;margin-top:1rem;color:var(--blush)}
.hint{margin-top:2.5rem;font-size:1rem;opacity:.7}
.card{max-width:36rem;background:rgba(92,10,28,.55);border:1px solid rgba(255,182,193,.35);border-radius:1.5rem;padding:2.2rem 1.8rem;backdrop-filter:blur(6px);box-shadow:0 10px 50px rgba(0,0,0,.35)}
.card h2{font-size:clamp(2.4rem,9vw,3.6rem);color:var(--blush);margin-bottom:1rem}
.card p+p{margin-top:1rem}
.big{font-size:clamp(1.8rem,6vw,2.6rem);max-width:20ch;line-height:1.3;color:var(--blush);font-style:italic}
.wishes{display:grid;gap:1rem;max-width:36rem}
.wishes p{border-left:3px solid var(--rose);padding:.2rem 0 .2rem 1rem;text-align:left}
button{font:inherit;font-size:1.3rem;color:var(--deep);background:var(--blush);border:0;border-radius:2rem;padding:.8rem 2rem;cursor:pointer;margin-top:1.5rem;box-shadow:0 0 25px rgba(255,77,109,.6)}
button:focus-visible{outline:3px solid #fff;outline-offset:3px}
#extra{display:none;margin-top:1.5rem;font-size:clamp(2.4rem,9vw,4rem);color:var(--blush)}
footer{position:relative;z-index:1;text-align:center;padding:3rem 1rem 4rem;opacity:.8}
.ask{min-height:100vh}.ask .big{margin-bottom:.5rem}.btns{display:flex;gap:1.2rem;justify-content:center;align-items:center;flex-wrap:wrap;margin-top:1.5rem;min-height:4.5rem}#yes{font-size:1.7rem;padding:.9rem 2.6rem;background:var(--rose);color:#fff;margin-top:0}#no{background:rgba(255,214,222,.25);color:var(--cream);margin-top:0;box-shadow:none;z-index:5}.ask{position:relative}#mu{position:fixed;right:1rem;bottom:calc(1rem + env(safe-area-inset-bottom,0px));z-index:6;font-size:1rem;padding:.55rem 1.1rem;margin:0}#yay{display:none;margin-top:1.5rem;font-size:clamp(2.6rem,10vw,4.5rem);line-height:1.15;color:var(--blush);text-shadow:0 0 30px rgba(255,77,109,.8)}
@media (prefers-reduced-motion:reduce){.h,.beat{animation:none}.h{opacity:.5}}
</style>
</head>
<body>
<div id="hearts" aria-hidden="true"></div>
<main>
<section class="hero">
<h1 class="script">I love you<span>Amira</span></h1>
<div class="beat" aria-hidden="true">&#10084;</div>
<p class="sub">Every word on this page was written with you in my heart.</p>
<p class="hint">Keep scrolling&hellip;</p>
</section>

<section>
<div class="card">
<h2 class="script">My dearest Amira Ahmed</h2>
<p>From the moment you came into my life, everything became softer, brighter, and more beautiful. Your smile is my favorite place to rest, and your voice is the sweetest sound I know.</p>
<p>I wanted to give you something that could hold what I feel, but no gift is big enough. So I built you a little world made only of hearts.</p>
</div>
</section>

<section>
<p class="big">You are the one I have loved the most in my whole life.</p>
<p class="sub">And with you, I truly fell in love with living.</p>
</section>

<section>
<div class="wishes">
<p>I love the way you laugh, and the way the whole room feels warmer when you walk in.</p>
<p>I love your kindness, your strength, and the little things you do without even noticing.</p>
<p>I love how, next to you, even ordinary days feel like a love story.</p>
<p>You are my peace, my home, and my favorite person in the whole world.</p>
</div>
</section>

<section>
<div class="card">
<h2 class="script">I’m sorry</h2>
<p>Please forgive me for every mistake I’ve ever made, and for every time I hurt you, even when I didn’t mean to.</p>
<p>You deserve nothing but love, and I promise to keep learning how to love you better, every single day.</p>
</div>
</section>

<section>
<p class="big">Forever isn’t long enough with you, Amira.</p>
<button id="b" type="button">Tap if you love me too</button>
<div id="extra" class="script">I love you more, always &#10084;</div>
</section>

<section class="ask">
<p class="big">Amira Ahmed, my love&hellip;</p>
<h2 class="script" style="font-size:clamp(2.6rem,10vw,4.5rem);color:var(--blush)">Will you be my girlfriend?</h2>
<div class="btns" id="btns">
<button id="yes" type="button">Yes &#10084;</button>
<button id="no" type="button">No</button>
</div>
<div id="yay" class="script">Yesss! I love you so much, Amira &#10084;<br>You just made me the happiest person alive.</div>
</section>
</main>
<footer class="script" style="font-size:2rem">With all my heart, forever yours</footer>
<button id="mu" type="button" aria-pressed="false">&#9834; Play our song</button>

<script>
(function(){
  var box=document.getElementById('hearts'),sym=['\u2764','\u2665','\uD83D\uDC96','\u2764'];
  for(var i=0;i<34;i++){
    var s=document.createElement('span');s.className='h';
    s.textContent=sym[i%sym.length];
    s.style.left=(Math.random()*100)+'%';
    s.style.fontSize=(14+Math.random()*34)+'px';
    s.style.color=['#ff4d6d','#ff8fa3','#ffb3c1','#e5173f'][i%4];
    s.style.animationDuration=(9+Math.random()*12)+'s';
    s.style.animationDelay=(-Math.random()*20)+'s';
    box.appendChild(s);
  }
  var no=document.getElementById('no'),yes=document.getElementById('yes');
  var area=document.querySelector('.ask'),last={x:-999,y:-999};
  function place(px,py){
    var w=area.clientWidth,h=area.clientHeight,bw=no.offsetWidth,bh=no.offsetHeight,m=12,x,y,n=0,ar=area.getBoundingClientRect(),yr=yes.getBoundingClientRect(),bad;
    do{
      x=m+Math.random()*Math.max(1,w-bw-2*m);y=m+Math.random()*Math.max(1,h-bh-2*m);
      var L=ar.left+x,T=ar.top+y;
      bad=Math.hypot(L+bw/2-px,T+bh/2-py)<180||Math.hypot(x-last.x,y-last.y)<120||(L<yr.right+12&&L+bw>yr.left-12&&T<yr.bottom+12&&T+bh>yr.top-12);
      n++;
    }while(bad&&n<40);
    last.x=x;last.y=y;
    no.style.position='absolute';no.style.left=x+'px';no.style.top=y+'px';
  }
  function near(e){
    var t=(e.touches&&e.touches[0])||e,px=t.clientX,py=t.clientY,r=no.getBoundingClientRect();
    if(px>r.left-70&&px<r.right+70&&py>r.top-70&&py<r.bottom+70)place(px,py);
  }
  document.addEventListener('pointermove',near);
  document.addEventListener('pointerdown',near);
  document.addEventListener('touchstart',near,{passive:true});
  no.addEventListener('click',function(e){e.preventDefault();place(e.clientX,e.clientY)});
  no.addEventListener('focus',function(){place(-999,-999);no.blur()});
  var ac,tm,st=0,mu=document.getElementById('mu'),CH=[[261.63,329.63,392,523.25],[220,261.63,329.63,440],[174.61,261.63,349.23,440],[196,246.94,392,493.88]],AP=[0,1,2,3,2,1,3,2];
  function tone(f,t,d,ty,v){var o=ac.createOscillator(),g=ac.createGain();o.type=ty;o.frequency.value=f;g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(v,t+.03);g.gain.exponentialRampToValueAtTime(0.0001,t+d);o.connect(g);g.connect(ac.destination);o.start(t);o.stop(t+d+.05);}
  function beat(){
    var t=ac.currentTime+.05,c=CH[Math.floor(st/8)%4],i=st%8;
    tone(c[AP[i]],t,1.6,'triangle',.16);
    if(i===0){tone(c[0]/2,t,3.2,'sine',.22);tone(c[3]*2,t,2.4,'sine',.09);}
    if(i===4)tone(c[2]*2,t,1.8,'sine',.08);
    st++;
  }
  mu.addEventListener('click',function(){
    var on=mu.getAttribute('aria-pressed')==='true';
    if(on){clearInterval(tm);mu.setAttribute('aria-pressed','false');mu.innerHTML='&#9834; Play our song';return;}
    try{ac=ac||new (window.AudioContext||window.webkitAudioContext)();if(ac.resume)ac.resume();}catch(e){return;}
    beat();tm=setInterval(beat,480);mu.setAttribute('aria-pressed','true');mu.innerHTML='&#9834; Pause';
  });
  yes.addEventListener('click',function(){
    document.getElementById('btns').style.display='none';
    document.getElementById('yay').style.display='block';
    for(var k=0;k<90;k++){
      var f=document.createElement('span');f.className='h';f.textContent=sym[k%sym.length];
      f.style.left=(Math.random()*100)+'%';f.style.fontSize=(20+Math.random()*44)+'px';
      f.style.color=['#ff4d6d','#ff8fa3','#ffb3c1','#e5173f'][k%4];
      f.style.animationDuration=(3+Math.random()*4)+'s';
      f.style.animationDelay=(Math.random()*1.5)+'s';
      f.style.animationIterationCount='1';
      box.appendChild(f);
    }
  });
  document.getElementById('b').addEventListener('click',function(){
    document.getElementById('extra').style.display='block';
    for(var j=0;j<40;j++){
      var f=document.createElement('span');f.className='h';f.textContent='\u2764';
      f.style.left=(Math.random()*100)+'%';f.style.fontSize=(20+Math.random()*40)+'px';
      f.style.color='#ff4d6d';f.style.animationDuration=(3+Math.random()*3)+'s';
      f.style.animationIterationCount='1';
      box.appendChild(f);
    }
  });
})();
</script>
</body>
</html>
